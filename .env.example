# Database Configuration
# Replace with your local or cloud MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/invoice-generator

# JWT Authentication Secret
# Replace with a secure random key
JWT_SECRET=your_jwt_secret_key_here

# SMTP Configuration (Optional: will fallback to console logging if omitted)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="SmartInvoice" <no-reply@yourdomain.com>

